// Schéma Konzia. Conventions : docs/03-modele-donnees.md
// Les politiques Row-Level Security sont écrites en SQL dans les migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identité (ticket #2)
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
}

enum PlatformRole {
  admin
  support
}

enum EmailTokenPurpose {
  verify_email
  reset_password
}

enum ConsentKind {
  terms
  privacy
  marketing
}

model User {
  id              String        @id @default(uuid(7)) @db.Uuid
  /// Toujours en minuscules (normalisé par la validation).
  email           String        @unique
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  passwordHash    String        @map("password_hash")
  displayName     String        @map("display_name")
  phoneWhatsapp   String?       @map("phone_whatsapp")
  locale          String        @default("fr")
  platformRole    PlatformRole? @map("platform_role")
  mfaSecretEnc    String?       @map("mfa_secret_enc")
  status          UserStatus    @default(active)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  emailTokens EmailToken[]
  consents    Consent[]
  memberships OrganizationMember[]
  profile     CustomerProfile?
  addresses   Address[]
  customerOf  OrgCustomer[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 du jeton ; le jeton lui-même n'est jamais stocké.
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  /// Empreinte salée de l'adresse IP (jamais l'IP en clair).
  ipHash     String?   @map("ip_hash")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

model Consent {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  kind      ConsentKind
  /// Version du texte accepté (ex. « 2026-11 »).
  version   String
  granted   Boolean
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// Organisations et membres (ticket #3) — tables soumises à la RLS
// ---------------------------------------------------------------------------

enum OrganizationType {
  independent
  company
}

enum OrganizationStatus {
  pending
  approved
  rejected
  suspended
}

enum OrgRole {
  owner
  sales
  buyer
  logistics
  accountant
  courier
}

enum MemberStatus {
  active
  removed
}

model Organization {
  id                     String             @id @default(uuid(7)) @db.Uuid
  type                   OrganizationType
  name                   String
  slug                   String             @unique
  description            String?
  phoneWhatsapp          String?            @map("phone_whatsapp")
  /// Service d'importation opéré par Konzia : aucun privilège lié à ce drapeau.
  /// Codes des marketplaces prises en charge (shein, aliexpress, amazon…).
  marketplaces           String[]           @default([])
  /// Modes de transport proposés : air, sea, road.
  transportModes         String[]           @default([]) @map("transport_modes")
  pricingPolicy          String?            @map("pricing_policy")
  /// Instructions de paiement direct affichées au client (moyens, numéros, titulaires).
  paymentInstructions    Json?              @map("payment_instructions")
  /// Réglages de l'assistant de devis : commission (points de base, 1000 = 10 %) et transport au kilo.
  commissionBps          Int?               @map("commission_bps")
  transportPerKgAmount   BigInt?            @map("transport_per_kg_amount")
  transportPerKgCurrency String?            @map("transport_per_kg_currency") @db.Char(3)
  isPlatformOperated     Boolean            @default(false) @map("is_platform_operated")
  status                 OrganizationStatus @default(pending)
  /// Date de la dernière approbation (publique : badge « Nouveau »). Écrite par l'administration.
  verifiedAt             DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  members       OrganizationMember[]
  invitations   Invitation[]
  serviceZones  OrganizationServiceZone[]
  customers     OrgCustomer[]
  verifications OrganizationVerification[]
  requests      QuoteRequestRecipient[]
  quotes        Quote[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           OrgRole
  status         MemberStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  role           OrgRole
  tokenHash      String    @unique @map("token_hash")
  invitedBy      String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Journal d'audit (ticket #4) — insertion seule, immuable
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// Nul pour une action du système (tâche planifiée, migration de données).
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  /// Rôle sous lequel l'acteur agissait (owner, sales…, platform_admin, system).
  actorRole      String   @map("actor_role")
  organizationId String?  @map("organization_id") @db.Uuid
  /// Verbe stable, ex. « org.member.role_changed ».
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Villes et zones (ticket #5) — référentiel global, géré par l'administrateur
// ---------------------------------------------------------------------------

enum HandoverMode {
  pickup
  delivery
  partner_point
}

model City {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  country   String   @default("CD")
  isActive  Boolean  @default(false) @map("is_active")
  timezone  String   @default("Africa/Lubumbashi")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  zones     ServiceZone[]
  profiles  CustomerProfile[]
  addresses Address[]
  customers OrgCustomer[]
  requests  QuoteRequest[]

  @@map("cities")
}

model ServiceZone {
  id        String   @id @default(uuid(7)) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  /// Commune ou quartier.
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city          City                      @relation(fields: [cityId], references: [id])
  organizations OrganizationServiceZone[]
  profiles      CustomerProfile[]
  addresses     Address[]
  customers     OrgCustomer[]

  @@unique([cityId, name])
  @@map("service_zones")
}

/// Zones desservies par un commissionnaire, avec modes de remise et frais locaux.
model OrganizationServiceZone {
  id               String         @id @default(uuid(7)) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  serviceZoneId    String         @map("service_zone_id") @db.Uuid
  handoverModes    HandoverMode[] @map("handover_modes")
  /// Frais de livraison locale en unité mineure ; nul = sur devis.
  localFeeAmount   BigInt?        @map("local_fee_amount")
  localFeeCurrency String?        @map("local_fee_currency") @db.Char(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  serviceZone  ServiceZone  @relation(fields: [serviceZoneId], references: [id])

  @@unique([organizationId, serviceZoneId])
  @@map("organization_service_zones")
}

// ---------------------------------------------------------------------------
// Profil client et adresses (ticket #6) — données personnelles, RLS par utilisateur
// ---------------------------------------------------------------------------

model CustomerProfile {
  userId               String   @id @map("user_id") @db.Uuid
  cityId               String?  @map("city_id") @db.Uuid
  serviceZoneId        String?  @map("service_zone_id") @db.Uuid
  deliveryInstructions String?  @map("delivery_instructions")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        City?        @relation(fields: [cityId], references: [id])
  serviceZone ServiceZone? @relation(fields: [serviceZoneId], references: [id])

  @@map("customer_profiles")
}

model Address {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String
  cityId        String   @map("city_id") @db.Uuid
  serviceZoneId String?  @map("service_zone_id") @db.Uuid
  line          String
  /// Point de repère (très utilisé à Lubumbashi : « en face de l'église… »).
  landmark      String?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        City         @relation(fields: [cityId], references: [id])
  serviceZone ServiceZone? @relation(fields: [serviceZoneId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Clients d'un commissionnaire (ticket #7) — décision D4
// ---------------------------------------------------------------------------

enum OrgCustomerSource {
  signup
  manual
  import
}

enum OrgCustomerStatus {
  active
  /// Fiche fusionnée dans une autre lors d'une réclamation de compte.
  merged
  archived
}

/// La fiche d'un client chez UN commissionnaire. Jamais partagée entre organisations.
model OrgCustomer {
  id                  String            @id @default(uuid(7)) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  /// Renseigné si le client a un compte Konzia (inscription ou réclamation).
  userId              String?           @map("user_id") @db.Uuid
  fullName            String            @map("full_name")
  phoneWhatsapp       String?           @map("phone_whatsapp")
  email               String?
  cityId              String?           @map("city_id") @db.Uuid
  serviceZoneId       String?           @map("service_zone_id") @db.Uuid
  addressLine         String?           @map("address_line")
  landmark            String?
  /// Notes internes du commissionnaire : jamais visibles du client.
  notesPrivate        String?           @map("notes_private")
  source              OrgCustomerSource
  status              OrgCustomerStatus @default(active)
  mergedIntoId        String?           @map("merged_into_id") @db.Uuid
  claimTokenHash      String?           @unique @map("claim_token_hash")
  claimTokenExpiresAt DateTime?         @map("claim_token_expires_at") @db.Timestamptz(3)
  claimedAt           DateTime?         @map("claimed_at") @db.Timestamptz(3)
  createdBy           String?           @map("created_by") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization            @relation(fields: [organizationId], references: [id])
  user         User?                   @relation(fields: [userId], references: [id])
  city         City?                   @relation(fields: [cityId], references: [id])
  serviceZone  ServiceZone?            @relation(fields: [serviceZoneId], references: [id])
  requests     QuoteRequestRecipient[]

  @@index([organizationId, status])
  @@index([userId])
  @@map("org_customers")
}

// ---------------------------------------------------------------------------
// Fichiers et vérification des commissionnaires (ticket #10)
// ---------------------------------------------------------------------------

enum FilePurpose {
  verification_document
  product_screenshot
  payment_proof
  purchase_proof
  parcel_photo
}

/// Fichier stocké chiffré (AES-256-GCM) ; le contenu n'est jamais servi sans contrôle d'accès.
model StoredFile {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  ownerUserId    String      @map("owner_user_id") @db.Uuid
  purpose        FilePurpose
  storageKey     String      @unique @map("storage_key")
  originalName   String      @map("original_name")
  mime           String
  sizeBytes      Int         @map("size_bytes")
  sha256         String
  /// Identifiant de la clé de chiffrement (rotation).
  keyId          String      @map("key_id")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  documents VerificationDocument[]

  @@index([organizationId])
  @@map("files")
}

enum VerificationStatus {
  draft
  submitted
  approved
  rejected
}

enum VerificationDocumentKind {
  rccm
  identity
}

model OrganizationVerification {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  status         VerificationStatus @default(draft)
  submittedAt    DateTime?          @map("submitted_at") @db.Timestamptz(3)
  submittedBy    String?            @map("submitted_by") @db.Uuid
  decidedAt      DateTime?          @map("decided_at") @db.Timestamptz(3)
  decidedBy      String?            @map("decided_by") @db.Uuid
  reason         String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id])
  documents    VerificationDocument[]

  @@index([organizationId])
  @@map("organization_verifications")
}

model VerificationDocument {
  id             String                   @id @default(uuid(7)) @db.Uuid
  verificationId String                   @map("verification_id") @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  kind           VerificationDocumentKind
  fileId         String                   @map("file_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  verification OrganizationVerification @relation(fields: [verificationId], references: [id])
  file         StoredFile               @relation(fields: [fileId], references: [id])

  @@unique([verificationId, kind])
  @@map("verification_documents")
}

// ---------------------------------------------------------------------------
// Imports de clients (ticket #12) — résumé seulement, le fichier n'est pas conservé
// ---------------------------------------------------------------------------

model CustomerImport {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  importedBy     String   @map("imported_by") @db.Uuid
  fileName       String   @map("file_name")
  rowsTotal      Int      @map("rows_total")
  rowsImported   Int      @map("rows_imported")
  rowsSkipped    Int      @map("rows_skipped")
  /// Lignes ignorées : { line, reason } (sans données personnelles).
  issues         Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@map("customer_imports")
}

// ---------------------------------------------------------------------------
// Demandes de devis (ticket #14)
// ---------------------------------------------------------------------------

enum QuoteRequestStatus {
  draft
  sent
  partially_quoted
  quoted
  expired
  cancelled
  converted
}

enum RecipientStatus {
  sent
  viewed
  evaluating
  quoted
  declined
  expired
}

enum ItemSource {
  lookup
  manual
}

model QuoteRequest {
  id                      String             @id @default(uuid(7)) @db.Uuid
  /// Client avec compte ; nul pour une demande saisie par un commissionnaire pour un client géré.
  customerUserId          String?            @map("customer_user_id") @db.Uuid
  createdByOrganizationId String?            @map("created_by_organization_id") @db.Uuid
  createdByUserId         String             @map("created_by_user_id") @db.Uuid
  cityId                  String?            @map("city_id") @db.Uuid
  /// Copie de l'adresse au moment de l'envoi (l'adresse d'origine peut changer ensuite).
  deliveryAddress         Json?              @map("delivery_address")
  note                    String?
  status                  QuoteRequestStatus @default(draft)
  deadlineAt              DateTime?          @map("deadline_at") @db.Timestamptz(3)
  sentAt                  DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdAt               DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  items      QuoteRequestItem[]
  recipients QuoteRequestRecipient[]
  city       City?                   @relation(fields: [cityId], references: [id])

  @@index([customerUserId, status])
  @@index([createdByOrganizationId])
  @@map("quote_requests")
}

model QuoteRequestItem {
  id                      String     @id @default(uuid(7)) @db.Uuid
  quoteRequestId          String     @map("quote_request_id") @db.Uuid
  position                Int
  source                  ItemSource
  sourceUrl               String?    @map("source_url")
  marketplace             String?
  title                   String
  variant                 String?
  size                    String?
  color                   String?
  quantity                Int
  notes                   String?
  imageUrl                String?    @map("image_url")
  /// Prix lu sur la page : INDICATIF, daté (priceFetchedAt), jamais un prix final.
  indicativePriceAmount   BigInt?    @map("indicative_price_amount")
  indicativePriceCurrency String?    @map("indicative_price_currency") @db.Char(3)
  priceFetchedAt          DateTime?  @map("price_fetched_at") @db.Timestamptz(3)
  screenshotFileId        String?    @map("screenshot_file_id") @db.Uuid
  createdAt               DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt               DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id], onDelete: Cascade)

  @@index([quoteRequestId])
  @@map("quote_request_items")
}

model QuoteRequestRecipient {
  id             String          @id @default(uuid(7)) @db.Uuid
  quoteRequestId String          @map("quote_request_id") @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  orgCustomerId  String          @map("org_customer_id") @db.Uuid
  status         RecipientStatus @default(sent)
  viewedAt       DateTime?       @map("viewed_at") @db.Timestamptz(3)
  declineReason  String?         @map("decline_reason")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  quoteRequest QuoteRequest @relation(fields: [quoteRequestId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
  orgCustomer  OrgCustomer  @relation(fields: [orgCustomerId], references: [id])
  quote        Quote?

  @@unique([quoteRequestId, organizationId])
  @@index([organizationId, status])
  @@map("quote_request_recipients")
}

// ---------------------------------------------------------------------------
// Taux de change (ticket #8) — insertion seule, copiés dans chaque devis (D3)
// ---------------------------------------------------------------------------

model ExchangeRate {
  id        String   @id @default(uuid(7)) @db.Uuid
  /// Paire « USD_CDF » ou « USD_CNY » : 1 unité de la base = `rate` unités cotées.
  pair      String
  rate      Decimal  @db.Decimal(18, 8)
  source    String
  validFrom DateTime @default(now()) @map("valid_from") @db.Timestamptz(3)
  createdBy String   @map("created_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([pair, validFrom])
  @@map("exchange_rates")
}

// ---------------------------------------------------------------------------
// Devis (ticket #15) — versions figées à l'envoi
// ---------------------------------------------------------------------------

enum QuoteStatus {
  draft
  sent
  accepted
  rejected
  changes_requested
  expired
  withdrawn
}

enum QuoteVersionStatus {
  draft
  sent
  superseded
  accepted
  rejected
  expired
  withdrawn
}

enum QuoteLineKind {
  product
  seller_shipping
  service_fee
  international_shipping
  handling
  customs_estimate
  local_delivery
  insurance
  discount
}

model Quote {
  id             String      @id @default(uuid(7)) @db.Uuid
  recipientId    String      @unique @map("recipient_id") @db.Uuid
  quoteRequestId String      @map("quote_request_id") @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  orgCustomerId  String      @map("org_customer_id") @db.Uuid
  customerUserId String?     @map("customer_user_id") @db.Uuid
  status         QuoteStatus @default(draft)
  /// Motif d'une demande de correction du client.
  changeRequest  String?     @map("change_request")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  recipient    QuoteRequestRecipient @relation(fields: [recipientId], references: [id])
  organization Organization          @relation(fields: [organizationId], references: [id])
  versions     QuoteVersion[]

  @@index([quoteRequestId])
  @@index([organizationId, status])
  @@map("quotes")
}

model QuoteVersion {
  id                String             @id @default(uuid(7)) @db.Uuid
  quoteId           String             @map("quote_id") @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  versionNo         Int                @map("version_no")
  status            QuoteVersionStatus @default(draft)
  currency          String             @db.Char(3)
  productsAmount    BigInt             @default(0) @map("products_amount")
  totalAmount       BigInt             @default(0) @map("total_amount")
  /// Taux copiés à l'envoi (D3) : un nouveau taux ne modifie jamais ce devis.
  fxUsdCdf          Decimal?           @map("fx_usd_cdf") @db.Decimal(18, 8)
  fxUsdCny          Decimal?           @map("fx_usd_cny") @db.Decimal(18, 8)
  fxSource          String?            @map("fx_source")
  fxAt              DateTime?          @map("fx_at") @db.Timestamptz(3)
  validUntil        DateTime           @map("valid_until") @db.Timestamptz(3)
  leadTimeMinDays   Int                @map("lead_time_min_days")
  leadTimeMaxDays   Int                @map("lead_time_max_days")
  weightGrams       Int?               @map("weight_grams")
  assumptions       String?
  cancellationTerms String?            @map("cancellation_terms")
  sentAt            DateTime?          @map("sent_at") @db.Timestamptz(3)
  createdBy         String             @map("created_by") @db.Uuid
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  quote Quote       @relation(fields: [quoteId], references: [id])
  lines QuoteLine[]

  @@unique([quoteId, versionNo])
  @@map("quote_versions")
}

model QuoteLine {
  id                 String        @id @default(uuid(7)) @db.Uuid
  quoteVersionId     String        @map("quote_version_id") @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  position           Int
  kind               QuoteLineKind
  quoteRequestItemId String?       @map("quote_request_item_id") @db.Uuid
  description        String
  quantity           Int
  unitAmount         BigInt        @map("unit_amount")
  /// Calculé par le serveur : quantité × prix unitaire (négatif pour une réduction).
  amount             BigInt
  isEstimate         Boolean       @default(false) @map("is_estimate")
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  version QuoteVersion @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)

  @@index([quoteVersionId])
  @@map("quote_lines")
}

// ---------------------------------------------------------------------------
// Commandes (tickets #16-#17) — créées à l'acceptation d'une version de devis
// ---------------------------------------------------------------------------

enum OrderStatus {
  awaiting_payment
  payment_to_verify
  paid
  purchasing
  partially_purchased
  purchased
  in_logistics
  in_transit
  at_distribution_point
  ready_for_handover
  completed
  cancelled
  in_dispute
}

enum OrderPaymentStatus {
  unpaid
  partially_paid
  paid
  partially_refunded
  refunded
}

model Order {
  id                String             @id @default(uuid(7)) @db.Uuid
  /// Numéro lisible, ex. KZ-2026-000123.
  number            String             @unique
  organizationId    String             @map("organization_id") @db.Uuid
  orgCustomerId     String             @map("org_customer_id") @db.Uuid
  customerUserId    String?            @map("customer_user_id") @db.Uuid
  quoteId           String             @map("quote_id") @db.Uuid
  quoteVersionId    String             @unique @map("quote_version_id") @db.Uuid
  currency          String             @db.Char(3)
  agreedTotalAmount BigInt             @map("agreed_total_amount")
  /// Montant facturé : convenu + ajustements acceptés par le client.
  finalAmount       BigInt             @map("final_amount")
  status            OrderStatus        @default(awaiting_payment)
  paymentStatus     OrderPaymentStatus @default(unpaid) @map("payment_status")
  cancelledReason   String?            @map("cancelled_reason")
  /// Règle d'achat (retour terrain R3) : tout payé, acompte (depositBps) ou achat sur fonds propres.
  purchaseRule      PurchaseRule       @default(full_payment) @map("purchase_rule")
  depositBps        Int?               @map("deposit_bps")
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  items       OrderItem[]
  events      OrderEvent[]
  adjustments OrderAdjustment[]
  payments    Payment[]

  @@index([organizationId, status])
  @@index([customerUserId])
  @@map("orders")
}

model OrderItem {
  id                 String   @id @default(uuid(7)) @db.Uuid
  orderId            String   @map("order_id") @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  customerUserId     String?  @map("customer_user_id") @db.Uuid
  quoteLineId        String   @map("quote_line_id") @db.Uuid
  quoteRequestItemId String?  @map("quote_request_item_id") @db.Uuid
  description        String
  quantity           Int
  unitAmount         BigInt   @map("unit_amount")
  amount             BigInt
  qtyPurchased       Int      @default(0) @map("qty_purchased")
  qtyReceived        Int      @default(0) @map("qty_received")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  order         Order               @relation(fields: [orderId], references: [id])
  supplierItems SupplierOrderItem[]
  parcelItems   ParcelItem[]

  @@index([orderId])
  @@map("order_items")
}

/// Historique d'une commande : insertion seule.
model OrderEvent {
  id             String       @id @default(uuid(7)) @db.Uuid
  orderId        String       @map("order_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  type           String
  fromStatus     OrderStatus? @map("from_status")
  toStatus       OrderStatus? @map("to_status")
  actorUserId    String?      @map("actor_user_id") @db.Uuid
  note           String?
  at             DateTime     @default(now()) @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId, at])
  @@map("order_events")
}

enum AdjustmentStatus {
  proposed
  accepted
  rejected
  cancelled
}

/// Modification du prix après acceptation : n'a d'effet qu'une fois acceptée par le client (§7.12).
model OrderAdjustment {
  id             String           @id @default(uuid(7)) @db.Uuid
  orderId        String           @map("order_id") @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  customerUserId String?          @map("customer_user_id") @db.Uuid
  /// Variation en unité mineure : positive (supplément) ou négative (remise).
  amountDelta    BigInt           @map("amount_delta")
  reason         String
  status         AdjustmentStatus @default(proposed)
  proposedBy     String           @map("proposed_by") @db.Uuid
  decidedBy      String?          @map("decided_by") @db.Uuid
  decidedAt      DateTime?        @map("decided_at") @db.Timestamptz(3)
  /// Pour un client géré : comment l'accord a été obtenu (« accord reçu par WhatsApp le … »).
  decisionNote   String?          @map("decision_note")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_adjustments")
}

// ---------------------------------------------------------------------------
// Paiements directs (ticket #18) — la plateforme ne détient aucun fonds
// ---------------------------------------------------------------------------

enum PaymentKind {
  payment
  refund
}

enum PaymentMethod {
  mobile_money
  cash
  bank_transfer
  other
}

enum PaymentStatus {
  pending_verification
  confirmed
  rejected
  cancelled
}

model Payment {
  id              String        @id @default(uuid(7)) @db.Uuid
  organizationId  String        @map("organization_id") @db.Uuid
  orderId         String        @map("order_id") @db.Uuid
  orgCustomerId   String        @map("org_customer_id") @db.Uuid
  customerUserId  String?       @map("customer_user_id") @db.Uuid
  kind            PaymentKind   @default(payment)
  method          PaymentMethod
  /// Opérateur : M-Pesa, Orange Money, Airtel Money, nom de la banque…
  provider        String?
  amount          BigInt
  currency        String        @db.Char(3)
  /// Montant converti dans la devise de la commande, au taux figé ci-dessous.
  orderAmount     BigInt        @map("order_amount")
  fxRate          Decimal?      @map("fx_rate") @db.Decimal(18, 8)
  payerReference  String?       @map("payer_reference")
  proofFileId     String?       @map("proof_file_id") @db.Uuid
  note            String?
  status          PaymentStatus
  declaredBy      String        @map("declared_by") @db.Uuid
  confirmedBy     String?       @map("confirmed_by") @db.Uuid
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz(3)
  rejectionReason String?       @map("rejection_reason")
  idempotencyKey  String?       @unique @map("idempotency_key")
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  order  Order          @relation(fields: [orderId], references: [id])
  events PaymentEvent[]

  @@index([organizationId, status])
  @@index([orderId])
  @@index([orgCustomerId])
  @@map("payments")
}

/// Historique d'un paiement : insertion seule.
model PaymentEvent {
  id             String   @id @default(uuid(7)) @db.Uuid
  paymentId      String   @map("payment_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  type           String
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  note           String?
  at             DateTime @default(now()) @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id])

  @@index([paymentId])
  @@map("payment_events")
}

// ---------------------------------------------------------------------------
// Achats fournisseurs (ticket #19) — coûts réels, jamais visibles du client
// ---------------------------------------------------------------------------

enum PurchaseRule {
  full_payment
  deposit
  own_funds
}

enum SupplierOrderStatus {
  placed
  shipped_by_seller
  partially_received
  received
  refunded
  cancelled
}

model SupplierOrder {
  id                   String              @id @default(uuid(7)) @db.Uuid
  organizationId       String              @map("organization_id") @db.Uuid
  marketplace          String?
  storeName            String              @map("store_name")
  externalRef          String?             @map("external_ref")
  purchasedAt          DateTime            @map("purchased_at") @db.Timestamptz(3)
  /// Montant réellement payé au vendeur, dans sa devise (souvent CNY ou USD).
  amount               BigInt
  currency             String              @db.Char(3)
  conversionFeeAmount  BigInt              @default(0) @map("conversion_fee_amount")
  sellerTrackingNumber String?             @map("seller_tracking_number")
  proofFileId          String?             @map("proof_file_id") @db.Uuid
  note                 String?
  status               SupplierOrderStatus @default(placed)
  createdBy            String              @map("created_by") @db.Uuid
  createdAt            DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  items SupplierOrderItem[]

  @@index([organizationId, status])
  @@map("supplier_orders")
}

model SupplierOrderItem {
  id              String   @id @default(uuid(7)) @db.Uuid
  supplierOrderId String   @map("supplier_order_id") @db.Uuid
  orderItemId     String   @map("order_item_id") @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  qtyPurchased    Int      @map("qty_purchased")
  qtyReceived     Int      @default(0) @map("qty_received")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  supplierOrder SupplierOrder @relation(fields: [supplierOrderId], references: [id])
  orderItem     OrderItem     @relation(fields: [orderItemId], references: [id])

  @@unique([supplierOrderId, orderItemId])
  @@index([orderItemId])
  @@map("supplier_order_items")
}

enum ParcelStatus {
  open
  closed
  delivered
  lost
  cancelled
}

enum ParcelCondition {
  ok
  damaged
  opened
}

/// Colis préparé par le commissionnaire : peut mélanger des articles de plusieurs commandes et clients.
model Parcel {
  id                String          @id @default(uuid(7)) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  /// Code lisible, ex. KZ-P-7KD3QX.
  code              String          @unique
  locationLabel     String?         @map("location_label")
  weightG           Int?            @map("weight_g")
  lengthMm          Int?            @map("length_mm")
  widthMm           Int?            @map("width_mm")
  heightMm          Int?            @map("height_mm")
  /// Diviseur du transporteur (cm³ par kg), ex. 5000 ou 6000.
  volumetricDivisor Int             @default(5000) @map("volumetric_divisor")
  volumetricWeightG Int?            @map("volumetric_weight_g")
  condition         ParcelCondition @default(ok)
  status            ParcelStatus    @default(open)
  photoFileIds      String[]        @default([]) @map("photo_file_ids") @db.Uuid
  note              String?
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  items ParcelItem[]

  @@index([organizationId, status])
  @@map("parcels")
}

/// Article dans un colis. Retrait = marquage (removed_at), jamais suppression.
model ParcelItem {
  id             String    @id @default(uuid(7)) @db.Uuid
  parcelId       String    @map("parcel_id") @db.Uuid
  orderItemId    String    @map("order_item_id") @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  orgCustomerId  String    @map("org_customer_id") @db.Uuid
  customerUserId String?   @map("customer_user_id") @db.Uuid
  quantity       Int
  addedAt        DateTime  @default(now()) @map("added_at") @db.Timestamptz(3)
  addedBy        String    @map("added_by") @db.Uuid
  removedAt      DateTime? @map("removed_at") @db.Timestamptz(3)
  removedBy      String?   @map("removed_by") @db.Uuid
  removedReason  String?   @map("removed_reason")

  parcel    Parcel    @relation(fields: [parcelId], references: [id])
  orderItem OrderItem @relation(fields: [orderItemId], references: [id])

  @@index([parcelId])
  @@index([orderItemId])
  @@map("parcel_items")
}
