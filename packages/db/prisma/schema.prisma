// Schéma Konzia. Conventions : docs/03-modele-donnees.md
// Les politiques Row-Level Security sont écrites en SQL dans les migrations.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identité (ticket #2)
// ---------------------------------------------------------------------------

enum UserStatus {
  active
  suspended
}

enum PlatformRole {
  admin
  support
}

enum EmailTokenPurpose {
  verify_email
  reset_password
}

enum ConsentKind {
  terms
  privacy
  marketing
}

model User {
  id              String        @id @default(uuid(7)) @db.Uuid
  /// Toujours en minuscules (normalisé par la validation).
  email           String        @unique
  emailVerifiedAt DateTime?     @map("email_verified_at") @db.Timestamptz(3)
  passwordHash    String        @map("password_hash")
  displayName     String        @map("display_name")
  phoneWhatsapp   String?       @map("phone_whatsapp")
  locale          String        @default("fr")
  platformRole    PlatformRole? @map("platform_role")
  mfaSecretEnc    String?       @map("mfa_secret_enc")
  status          UserStatus    @default(active)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions    Session[]
  emailTokens EmailToken[]
  consents    Consent[]
  memberships OrganizationMember[]
  profile     CustomerProfile?
  addresses   Address[]
  customerOf  OrgCustomer[]

  @@map("users")
}

model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  /// SHA-256 du jeton ; le jeton lui-même n'est jamais stocké.
  tokenHash  String    @unique @map("token_hash")
  userAgent  String?   @map("user_agent")
  /// Empreinte salée de l'adresse IP (jamais l'IP en clair).
  ipHash     String?   @map("ip_hash")
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(3)
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model EmailToken {
  id        String            @id @default(uuid(7)) @db.Uuid
  userId    String            @map("user_id") @db.Uuid
  purpose   EmailTokenPurpose
  tokenHash String            @unique @map("token_hash")
  expiresAt DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime?         @map("used_at") @db.Timestamptz(3)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
  @@map("email_tokens")
}

model Consent {
  id        String      @id @default(uuid(7)) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  kind      ConsentKind
  /// Version du texte accepté (ex. « 2026-11 »).
  version   String
  granted   Boolean
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
  @@map("consents")
}

// ---------------------------------------------------------------------------
// Organisations et membres (ticket #3) — tables soumises à la RLS
// ---------------------------------------------------------------------------

enum OrganizationType {
  independent
  company
}

enum OrganizationStatus {
  pending
  approved
  rejected
  suspended
}

enum OrgRole {
  owner
  sales
  buyer
  logistics
  accountant
  courier
}

enum MemberStatus {
  active
  removed
}

model Organization {
  id                 String             @id @default(uuid(7)) @db.Uuid
  type               OrganizationType
  name               String
  slug               String             @unique
  description        String?
  phoneWhatsapp      String?            @map("phone_whatsapp")
  /// Service d'importation opéré par Konzia : aucun privilège lié à ce drapeau.
  /// Codes des marketplaces prises en charge (shein, aliexpress, amazon…).
  marketplaces       String[]           @default([])
  /// Modes de transport proposés : air, sea, road.
  transportModes     String[]           @default([]) @map("transport_modes")
  pricingPolicy      String?            @map("pricing_policy")
  isPlatformOperated Boolean            @default(false) @map("is_platform_operated")
  status             OrganizationStatus @default(pending)
  /// Date de la dernière approbation (publique : badge « Nouveau »). Écrite par l'administration.
  verifiedAt         DateTime?          @map("verified_at") @db.Timestamptz(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  members       OrganizationMember[]
  invitations   Invitation[]
  serviceZones  OrganizationServiceZone[]
  customers     OrgCustomer[]
  verifications OrganizationVerification[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid(7)) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           OrgRole
  status         MemberStatus @default(active)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([organizationId, userId])
  @@index([userId])
  @@map("organization_members")
}

model Invitation {
  id             String    @id @default(uuid(7)) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  email          String
  role           OrgRole
  tokenHash      String    @unique @map("token_hash")
  invitedBy      String    @map("invited_by") @db.Uuid
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  acceptedAt     DateTime? @map("accepted_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("invitations")
}

// ---------------------------------------------------------------------------
// Journal d'audit (ticket #4) — insertion seule, immuable
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(uuid(7)) @db.Uuid
  /// Nul pour une action du système (tâche planifiée, migration de données).
  actorUserId    String?  @map("actor_user_id") @db.Uuid
  /// Rôle sous lequel l'acteur agissait (owner, sales…, platform_admin, system).
  actorRole      String   @map("actor_role")
  organizationId String?  @map("organization_id") @db.Uuid
  /// Verbe stable, ex. « org.member.role_changed ».
  action         String
  entityType     String   @map("entity_type")
  entityId       String?  @map("entity_id")
  before         Json?
  after          Json?
  reason         String?
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// ---------------------------------------------------------------------------
// Villes et zones (ticket #5) — référentiel global, géré par l'administrateur
// ---------------------------------------------------------------------------

enum HandoverMode {
  pickup
  delivery
  partner_point
}

model City {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String   @unique
  country   String   @default("CD")
  isActive  Boolean  @default(false) @map("is_active")
  timezone  String   @default("Africa/Lubumbashi")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  zones     ServiceZone[]
  profiles  CustomerProfile[]
  addresses Address[]
  customers OrgCustomer[]

  @@map("cities")
}

model ServiceZone {
  id        String   @id @default(uuid(7)) @db.Uuid
  cityId    String   @map("city_id") @db.Uuid
  /// Commune ou quartier.
  name      String
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  city          City                      @relation(fields: [cityId], references: [id])
  organizations OrganizationServiceZone[]
  profiles      CustomerProfile[]
  addresses     Address[]
  customers     OrgCustomer[]

  @@unique([cityId, name])
  @@map("service_zones")
}

/// Zones desservies par un commissionnaire, avec modes de remise et frais locaux.
model OrganizationServiceZone {
  id               String         @id @default(uuid(7)) @db.Uuid
  organizationId   String         @map("organization_id") @db.Uuid
  serviceZoneId    String         @map("service_zone_id") @db.Uuid
  handoverModes    HandoverMode[] @map("handover_modes")
  /// Frais de livraison locale en unité mineure ; nul = sur devis.
  localFeeAmount   BigInt?        @map("local_fee_amount")
  localFeeCurrency String?        @map("local_fee_currency") @db.Char(3)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  serviceZone  ServiceZone  @relation(fields: [serviceZoneId], references: [id])

  @@unique([organizationId, serviceZoneId])
  @@map("organization_service_zones")
}

// ---------------------------------------------------------------------------
// Profil client et adresses (ticket #6) — données personnelles, RLS par utilisateur
// ---------------------------------------------------------------------------

model CustomerProfile {
  userId               String   @id @map("user_id") @db.Uuid
  cityId               String?  @map("city_id") @db.Uuid
  serviceZoneId        String?  @map("service_zone_id") @db.Uuid
  deliveryInstructions String?  @map("delivery_instructions")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        City?        @relation(fields: [cityId], references: [id])
  serviceZone ServiceZone? @relation(fields: [serviceZoneId], references: [id])

  @@map("customer_profiles")
}

model Address {
  id            String   @id @default(uuid(7)) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  label         String
  cityId        String   @map("city_id") @db.Uuid
  serviceZoneId String?  @map("service_zone_id") @db.Uuid
  line          String
  /// Point de repère (très utilisé à Lubumbashi : « en face de l'église… »).
  landmark      String?
  isDefault     Boolean  @default(false) @map("is_default")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  city        City         @relation(fields: [cityId], references: [id])
  serviceZone ServiceZone? @relation(fields: [serviceZoneId], references: [id])

  @@index([userId])
  @@map("addresses")
}

// ---------------------------------------------------------------------------
// Clients d'un commissionnaire (ticket #7) — décision D4
// ---------------------------------------------------------------------------

enum OrgCustomerSource {
  signup
  manual
  import
}

enum OrgCustomerStatus {
  active
  /// Fiche fusionnée dans une autre lors d'une réclamation de compte.
  merged
  archived
}

/// La fiche d'un client chez UN commissionnaire. Jamais partagée entre organisations.
model OrgCustomer {
  id                  String            @id @default(uuid(7)) @db.Uuid
  organizationId      String            @map("organization_id") @db.Uuid
  /// Renseigné si le client a un compte Konzia (inscription ou réclamation).
  userId              String?           @map("user_id") @db.Uuid
  fullName            String            @map("full_name")
  phoneWhatsapp       String?           @map("phone_whatsapp")
  email               String?
  cityId              String?           @map("city_id") @db.Uuid
  serviceZoneId       String?           @map("service_zone_id") @db.Uuid
  addressLine         String?           @map("address_line")
  landmark            String?
  /// Notes internes du commissionnaire : jamais visibles du client.
  notesPrivate        String?           @map("notes_private")
  source              OrgCustomerSource
  status              OrgCustomerStatus @default(active)
  mergedIntoId        String?           @map("merged_into_id") @db.Uuid
  claimTokenHash      String?           @unique @map("claim_token_hash")
  claimTokenExpiresAt DateTime?         @map("claim_token_expires_at") @db.Timestamptz(3)
  claimedAt           DateTime?         @map("claimed_at") @db.Timestamptz(3)
  createdBy           String?           @map("created_by") @db.Uuid
  createdAt           DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User?        @relation(fields: [userId], references: [id])
  city         City?        @relation(fields: [cityId], references: [id])
  serviceZone  ServiceZone? @relation(fields: [serviceZoneId], references: [id])

  @@index([organizationId, status])
  @@index([userId])
  @@map("org_customers")
}

// ---------------------------------------------------------------------------
// Fichiers et vérification des commissionnaires (ticket #10)
// ---------------------------------------------------------------------------

enum FilePurpose {
  verification_document
  product_screenshot
}

/// Fichier stocké chiffré (AES-256-GCM) ; le contenu n'est jamais servi sans contrôle d'accès.
model StoredFile {
  id             String      @id @default(uuid(7)) @db.Uuid
  organizationId String?     @map("organization_id") @db.Uuid
  ownerUserId    String      @map("owner_user_id") @db.Uuid
  purpose        FilePurpose
  storageKey     String      @unique @map("storage_key")
  originalName   String      @map("original_name")
  mime           String
  sizeBytes      Int         @map("size_bytes")
  sha256         String
  /// Identifiant de la clé de chiffrement (rotation).
  keyId          String      @map("key_id")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)

  documents VerificationDocument[]

  @@index([organizationId])
  @@map("files")
}

enum VerificationStatus {
  draft
  submitted
  approved
  rejected
}

enum VerificationDocumentKind {
  rccm
  identity
}

model OrganizationVerification {
  id             String             @id @default(uuid(7)) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  status         VerificationStatus @default(draft)
  submittedAt    DateTime?          @map("submitted_at") @db.Timestamptz(3)
  submittedBy    String?            @map("submitted_by") @db.Uuid
  decidedAt      DateTime?          @map("decided_at") @db.Timestamptz(3)
  decidedBy      String?            @map("decided_by") @db.Uuid
  reason         String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization           @relation(fields: [organizationId], references: [id])
  documents    VerificationDocument[]

  @@index([organizationId])
  @@map("organization_verifications")
}

model VerificationDocument {
  id             String                   @id @default(uuid(7)) @db.Uuid
  verificationId String                   @map("verification_id") @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  kind           VerificationDocumentKind
  fileId         String                   @map("file_id") @db.Uuid
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(3)

  verification OrganizationVerification @relation(fields: [verificationId], references: [id])
  file         StoredFile               @relation(fields: [fileId], references: [id])

  @@unique([verificationId, kind])
  @@map("verification_documents")
}

// ---------------------------------------------------------------------------
// Imports de clients (ticket #12) — résumé seulement, le fichier n'est pas conservé
// ---------------------------------------------------------------------------

model CustomerImport {
  id             String   @id @default(uuid(7)) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  importedBy     String   @map("imported_by") @db.Uuid
  fileName       String   @map("file_name")
  rowsTotal      Int      @map("rows_total")
  rowsImported   Int      @map("rows_imported")
  rowsSkipped    Int      @map("rows_skipped")
  /// Lignes ignorées : { line, reason } (sans données personnelles).
  issues         Json
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([organizationId])
  @@map("customer_imports")
}
