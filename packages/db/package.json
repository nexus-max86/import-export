{
  "name": "@konzia/db",
  "version": "0.0.0",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "typecheck": "prisma generate && tsc -p tsconfig.json --noEmit",
    "migrate:dev": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "test": "echo \"(pas de test propre au paquet db : couvert par les tests de l'API)\"",
    "app-login": "node scripts/enable-app-login.cjs",
    "app-login:dev": "dotenv -e ../../.env -- node scripts/enable-app-login.cjs"
  },
  "dependencies": {
    "@prisma/client": "6.19.3"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "typescript": "5.9.3",
    "dotenv-cli": "10.0.0"
  }
}
