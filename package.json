{
  "name": "konzia",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @konzia/shared --filter @konzia/db build && pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @konzia/db generate",
    "db:migrate": "pnpm --filter @konzia/db migrate:dev",
    "db:deploy": "pnpm --filter @konzia/db migrate:deploy",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter @konzia/web e2e"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  }
}
