{
  "name": "konzia",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @konzia/shared --filter @konzia/db build && pnpm --parallel --filter ./apps/* dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @konzia/db generate",
    "db:migrate": "pnpm --filter @konzia/db migrate:dev && pnpm --filter @konzia/db app-login:dev",
    "db:deploy": "pnpm --filter @konzia/db migrate:deploy",
    "format:check": "prettier --check .",
    "e2e": "pnpm --filter @konzia/web e2e",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.4"
  },
  "pnpm": {
    "overrides": {
      "effect@<3.22.1": "3.22.5",
      "deepmerge-ts@<8": "8.0.2",
      "postcss@<8.5.12": "8.5.33",
      "file-type@<21.3.1": "21.3.4",
      "path-to-regexp@>=8 <8.4.0": "8.4.2",
      "multer@<2.3.0": "2.5.0",
      "uuid@<11.1.1": "11.1.1"
    }
  }
}
