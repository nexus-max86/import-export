# /opt/konzia/production.env (et staging.env) sur le VPS — chmod 600, propriétaire deploy.
# AUCUNE valeur réelle dans le dépôt. Générer les secrets : openssl rand -hex 32
GHCR_OWNER=nexus-max86
APP_URL=https://app.konzia.app

# Base de données (mots de passe de 8 à 128 caractères : lettres, chiffres, _ - .)
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

# Sécurité
HASH_SALT=
# Clé AES-256 des fichiers (openssl rand -base64 32). À conserver aussi hors du serveur.
FILES_ENCRYPTION_KEY=

# E-mails (Brevo SMTP)
EMAIL_TRANSPORT=smtp
SMTP_URL=smtps://IDENTIFIANT:CLE_SMTP@smtp-relay.brevo.com:465
EMAIL_FROM=Konzia <no-reply@konzia.app>

# Fichiers (Cloudflare R2, seau privé)
FILE_STORAGE=s3
S3_ENDPOINT=https://<id-compte>.r2.cloudflarestorage.com
S3_BUCKET=konzia-files
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# WhatsApp automatique : désactivé jusqu'à la validation Meta
WHATSAPP_TRANSPORT=disabled

# Sauvegardes (ticket #30) : clé PUBLIQUE age (la clé privée reste hors du serveur)
BACKUP_AGE_RECIPIENT=age1...
BACKUP_REMOTE=r2:konzia-backups
# Jeton R2 limité au seau des sauvegardes (écriture + liste + suppression des anciennes)
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_RETENTION_DAYS=30
# Heure UTC de la sauvegarde quotidienne (HHMM) — 00:15 UTC = 02:15 à Lubumbashi
BACKUP_TIME=0015
