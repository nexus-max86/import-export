# /opt/konzia/edge.env — frontal HTTPS (Caddy) partagé par production et staging.
KONZIA_DOMAIN=konzia.app
# Adresse de contact Let's Encrypt (avertissements d'expiration).
ACME_EMAIL=
# Accès à staging : utilisateur et empreinte du mot de passe
#   docker run --rm caddy:2.10.2 caddy hash-password --plaintext 'votre-mot-de-passe'
STAGING_USER=pilote
STAGING_PASSWORD_HASH=
