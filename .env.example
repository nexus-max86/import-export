# Copiez ce fichier en .env (jamais commité). Aucune valeur secrète ici.

# --- Base de données ---
# Rôle propriétaire : migrations uniquement.
DATABASE_URL=postgresql://konzia:konzia@localhost:5432/konzia_dev
# Rôle applicatif (sans BYPASSRLS) : utilisé par l'API à partir du ticket #3.
APP_DATABASE_URL=postgresql://konzia_app:konzia_app@localhost:5432/konzia_dev

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- API ---
API_PORT=3001
# URL publique de l'application (liens dans les e-mails).
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# --- Sécurité ---
# Sel secret pour les empreintes d'IP (au moins 32 caractères). Générez-le : openssl rand -hex 32
HASH_SALT=remplacez-moi-par-une-valeur-aleatoire-de-32-caracteres
SESSION_TTL_DAYS=30
# Nombre de proxys de confiance devant l'API (1 derrière Caddy en production).
TRUST_PROXY_HOPS=0

# --- E-mails ---
# fake = boîte d'envoi en mémoire (développement uniquement, liens affichés dans les logs) ; smtp = Brevo.
EMAIL_TRANSPORT=fake
# SMTP_URL=smtps://identifiant:motdepasse@smtp-relay.brevo.com:465
EMAIL_FROM=Konzia <no-reply@konzia.app>
# File d'envoi (BullMQ sur Redis) : tentatives et délai de base exponentiel (ms).
# EMAIL_MAX_ATTEMPTS=6
# EMAIL_RETRY_BASE_MS=30000

# --- Fichiers (documents de vérification, preuves) ---
# local = disque (développement uniquement) ; s3 = Cloudflare R2 ou compatible (production).
FILE_STORAGE=local
FILE_STORAGE_DIR=.storage
# S3_ENDPOINT=https://<compte>.r2.cloudflarestorage.com
# S3_BUCKET=konzia-documents
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Clé AES-256 des documents, 32 octets en base64 : openssl rand -base64 32
FILES_ENCRYPTION_KEY=remplacez-moi

# --- Lecture des pages produits ---
# http = lecture réelle des métadonnées publiques ; fake = données d'exemple (hors ligne, interdit en production).
PRODUCT_FETCHER=http
